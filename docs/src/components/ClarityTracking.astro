<script is:inline>
  (() => {
    // Microsoft Clarity - only fires once the visitor has accepted cookies (EU/GDPR requirement).
    let clarityLoaded = false;
    const loadClarity = () => {
      if (clarityLoaded) {
        return;
      }
      clarityLoaded = true;

      (function (c, l, a, r, i) {
        c[a] =
          c[a] ||
          function (...args) {
            (c[a].q = c[a].q || []).push(args);
          };
        const t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        const y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'xqzfjts4xt');
    };

    try {
      if (window.localStorage.getItem('dc_cookie_consent') === 'accepted') {
        loadClarity();
      }
    } catch {
      // localStorage unavailable - wait for the consent event instead.
    }

    window.addEventListener('dc-cookie-consent', (event) => {
      if (event.detail && event.detail.status === 'accepted') {
        loadClarity();
      }
    });
  })();
</script>
